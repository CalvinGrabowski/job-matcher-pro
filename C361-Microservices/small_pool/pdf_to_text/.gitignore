# === Python Environment & Dependencies ===
# Virtual environments
.venv/
venv/
ENV/
env/
target/

# Dependency directories (if using local pip caching)
.pip-cache/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# === Python Bytecode & Cache ===
# Compiled Python files
__pycache__/
*.py[cod]
*$py.class
*.so

# === IDEs and Text Editors ===
# VS Code settings
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# macOS specific files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# JetBrains/PyCharm
.idea/

# === Environment Variables / Secrets ===
# Crucial: Prevent uploading secret API keys, local ports, or DB strings
.env
.flaskenv
*.secret
secrets.json

# === Local Databases & System Testing ===
# SQLite databases or temporary run assets
*.db
*.sqlite3
*.log
instance/
dist/
build/